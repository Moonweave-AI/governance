{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonweave.ai/schemas/governance-document-metadata-v1.json",
  "title": "Moonweave Governance Document Metadata",
  "description": "Frontmatter required on authoritative governance documents.",
  "type": "object",
  "required": ["type", "status", "owner", "created", "updated", "last_reviewed", "summary", "canonical", "related", "supersedes", "superseded_by"],
  "properties": {
    "type": {"$ref": "./document-type-registry.json#/$defs/type"},
    "status": {"type": "string", "enum": ["Draft", "Active", "Deprecated", "Superseded", "Archived"]},
    "owner": {"type": "string", "minLength": 1},
    "created": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date"},
    "last_reviewed": {"type": "string", "format": "date"},
    "summary": {"type": "string", "minLength": 20, "maxLength": 280},
    "decision_scope": {"type": "string", "description": "Stable lowercase kebab-case identity for the decision governed by an RFC or ADR.", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "canonical": {"type": "string", "minLength": 1},
    "related": {"type": "array", "description": "Reciprocal links to related records. Local documents use relative paths.", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "supersedes": {"type": "array", "description": "Older governed records replaced by this record.", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "superseded_by": {"type": "array", "description": "Newer governed records that replace this record.", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "additionalProperties": true
}
